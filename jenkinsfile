pipeline {
    agent any
    tools {
        maven 'mymaven'
    }
    environment {
        DOCKERHUB_USER = 'emnakhelifi27'
        IMAGE_NAME     = 'my-country-service'
    }
    stages {
        stage('Checkout code') {
            steps {
                git branch: 'main', url: 'https://github.com/emna321/country-service.git'
            }
        }
        stage('Compile, test code, package') {
            steps {
                sh 'mvn clean install'
            }
            post {
                success {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('MySonarQubeServer') {
                    sh "mvn sonar:sonar -Dsonar.projectKey=country-service -Dsonar.projectName='country-service'"
                }
            }
        }
        stage('Deploy jar to Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-cred',
                        usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh 'mvn deploy -DskipTests'
                }
            }
        }
        stage('Upload reports to Nexus') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-cred',
                        usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                    sh '''
                        cd target
                        zip -r jacoco-report.zip site/jacoco
                        zip -r surefire-reports.zip surefire-reports
                        curl -u $NEXUS_USER:$NEXUS_PASS --upload-file jacoco-report.zip \
                            http://localhost:8083/repository/reports/build-${BUILD_NUMBER}/jacoco-report.zip
                        curl -u $NEXUS_USER:$NEXUS_PASS --upload-file surefire-reports.zip \
                            http://localhost:8083/repository/reports/build-${BUILD_NUMBER}/surefire-reports.zip
                    '''
                }
            }
        }

        // ===== NOUVELLES ÉTAPES DOCKER (TP 7) =====
        stage('Build Docker image') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .'
            }
        }
        stage('Push to DockerHub') {
            steps {
                withCredentials([string(credentialsId: 'dockerhub-pwd', variable: 'dockerhubpwd')]) {
                    sh 'echo $dockerhubpwd | docker login -u ${DOCKERHUB_USER} --password-stdin'
                }
                sh 'docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${DOCKERHUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}'
                sh 'docker push ${DOCKERHUB_USER}/${IMAGE_NAME}:${BUILD_NUMBER}'
            }
        }
        stage('Deploy micro-service') {
            steps {
                sh 'docker rm -f country-app || true'
                sh 'docker run -d --name country-app -p 8082:8080 ${IMAGE_NAME}:${BUILD_NUMBER}'
            }
        }
    }
}
// test webhook
